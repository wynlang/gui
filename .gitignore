# Build artifact of csrc/build.sh - regenerate with ./csrc/build.sh
libgui/
# Scratch file the wyn compiler drops in cwd when invoking the C compiler
wyn_cc_err.txt
*.wyn.c
*.wyn.out
*.out
*.dSYM/
.DS_Store
# Screenshots written by --screenshot and by the headless render tests
*.bmp
# Compiled example binaries (no extension, so they must be named)
examples/form
examples/designer
examples/showcase
examples/wizard
# Scratch projects the generator tests write into and then build
scratch/
# Test binaries left by `wyn build` inside tests/
tests/test_*
!tests/test_*.wyn
# compiled examples and their generated C
examples/*.wyn.c
examples/*.wyn.out
examples/designer
examples/showcase
examples/form
examples/wizard
libgui/
*.bmp

# Agent worktrees and session scratch - never part of the repo.
.claude/

# Built app bundles (wyn build --app output).
*.app/
