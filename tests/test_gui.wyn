// gui package tests — headless (no window)

// SDL2 scancodes
var SCANCODE_W = 26
var SCANCODE_A = 4
var SCANCODE_S = 22
var SCANCODE_D = 7
var SCANCODE_SPACE = 44
var SCANCODE_UP = 82
var SCANCODE_DOWN = 81
var SCANCODE_LEFT = 80
var SCANCODE_RIGHT = 79

fn main() -> int {
    Test.init("GUI Package")

    // Scancode constants
    Test.assert_eq_int(SCANCODE_W, 26, "SCANCODE_W")
    Test.assert_eq_int(SCANCODE_SPACE, 44, "SCANCODE_SPACE")
    Test.assert_eq_int(SCANCODE_UP, 82, "SCANCODE_UP")
    Test.assert_eq_int(SCANCODE_RIGHT, 79, "SCANCODE_RIGHT")

    // Color clamping
    var r = 300
    if r > 255 { r = 255 }
    Test.assert_eq_int(r, 255, "color clamp")

    // Window dimensions
    var w = 800
    var h = 600
    Test.assert_eq_int(w * h, 480000, "pixel count")

    // Button hit test
    var btn_x = 100
    var btn_y = 200
    var btn_w = 150
    var btn_h = 40
    var mx = 120
    var my = 210
    var hit = mx >= btn_x && mx < btn_x + btn_w && my >= btn_y && my < btn_y + btn_h
    Test.assert(hit, "button hit test")

    var mx2 = 50
    var hit2 = mx2 >= btn_x && mx2 < btn_x + btn_w && my >= btn_y && my < btn_y + btn_h
    Test.assert(!hit2, "button miss test")

    // Layout math
    var padding = 10
    var cols = 3
    var cell_w = (w - padding * (cols + 1)) / cols
    Test.assert(cell_w > 200, "grid cell width")

    Test.summary()
    return 0
}
