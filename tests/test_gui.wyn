// gui package tests - headless (no window)

var SCANCODE_W = 26
var SCANCODE_SPACE = 44
var SCANCODE_UP = 82
var SCANCODE_RIGHT = 79

test "SCANCODE_W" {
    assert_eq(SCANCODE_W, 26)
}

test "SCANCODE_SPACE" {
    assert_eq(SCANCODE_SPACE, 44)
}

test "SCANCODE_UP" {
    assert_eq(SCANCODE_UP, 82)
}

test "SCANCODE_RIGHT" {
    assert_eq(SCANCODE_RIGHT, 79)
}

test "color clamp" {
    var r = 300
    if r > 255 { r = 255 }
    assert_eq(r, 255)
}

test "pixel count" {
    var w = 800
    var h = 600
    assert_eq(w * h, 480000)
}

test "button hit test" {
    var btn_x = 100
    var btn_y = 200
    var btn_w = 150
    var btn_h = 40
    var mx = 120
    var my = 210
    assert(mx >= btn_x and mx < btn_x + btn_w and my >= btn_y and my < btn_y + btn_h)
}

test "button miss test" {
    var mx2 = 50
    var btn_x = 100
    var btn_w = 150
    assert(not (mx2 >= btn_x and mx2 < btn_x + btn_w))
}

test "grid cell width" {
    var w = 800
    var padding = 10
    var cols = 3
    var cell_w = (w - padding * (cols + 1)) / cols
    assert(cell_w > 200)
}
