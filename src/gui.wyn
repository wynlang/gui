// gui — Cross-platform desktop GUI for Wyn
// Wraps SDL2. Requires: brew install sdl2 / apt install libsdl2-dev
//
// Usage:
//   var win = Gui_window("My App", 800, 600)
//   while Gui_running(win) {
//       Gui_clear(win, 30, 30, 30)
//       Gui_rect(win, 10, 10, 200, 50, 0, 120, 255)
//       Gui_present(win)
//   }
//   Gui_close(win)

// SDL2 scancodes for Gui_key_down()
var SCANCODE_A = 4
var SCANCODE_D = 7
var SCANCODE_S = 22
var SCANCODE_W = 26
var SCANCODE_SPACE = 44
var SCANCODE_ESCAPE = 41
var SCANCODE_UP = 82
var SCANCODE_DOWN = 81
var SCANCODE_LEFT = 80
var SCANCODE_RIGHT = 79
