// gui - Cross-platform desktop GUI for Wyn
//
// Backed by SDL3 (src/gui_sdl3.c) behind a backend-agnostic C API
// (src/gui_backend.h), so a native Cocoa/Win32/GTK backend can be added later
// without changing a single line of Wyn written against this module.
//
// Requires: brew install sdl3 / apt install libsdl3-dev
// Text needs nothing extra - stb_truetype is vendored.
//
// Usage:
//   var win = Win_window("My App", 800, 600)
//   var font = Win_font_default(14)
//   while Win_running(win) == 1 {
//       Win_clear(win, 30, 30, 30)
//       Win_rect(win, 10, 10, 200, 50, 0, 120, 255)
//       Win_text(win, font, "Hello", 20, 25, 255, 255, 255)
//       Win_present(win)
//       Win_delay(16)
//   }
//   Win_close(win)

// ---- Lifecycle ------------------------------------------------------------

extern fn Win_window(title: string, width: int, height: int) -> int;
extern fn Win_running(win: int) -> int;
extern fn Win_close(win: int);

// 1 if a display is available. A program that may run headless (CI, ssh)
// should check this and exit cleanly rather than draw into nothing.
extern fn Win_available() -> int;

// "sdl3" today. For diagnostics, and for tests that skip without a display.
extern fn Win_backend_name() -> string;

// ---- Drawing --------------------------------------------------------------

extern fn Win_clear(win: int, r: int, g: int, b: int);
extern fn Win_rect(win: int, x: int, y: int, w: int, h: int, r: int, g: int, b: int);
extern fn Win_rect_outline(win: int, x: int, y: int, w: int, h: int, r: int, g: int, b: int);
extern fn Win_line(win: int, x1: int, y1: int, x2: int, y2: int, r: int, g: int, b: int);
extern fn Win_present(win: int);

// Restrict drawing to a rectangle; pass w or h <= 0 to clear the clip.
// Any scrolling or clipped widget needs this.
//
// ABSOLUTE, which is a trap for nested drawing: clearing the clip clears EVERY
// enclosing one, not just the innermost. A widget that clips itself and then
// clears (a text entry does) escapes the region its container established and
// paints over whatever lies outside it. Use the stack below when clips nest.
extern fn Win_clip(win: int, x: int, y: int, w: int, h: int);

// Nesting clips. Push INTERSECTS with the region already in force; pop restores
// the enclosing one. A child can only ever shrink its parent's visible area.
// Max depth 16; push returns 0 rather than overflowing, pop returns 0 on an
// empty stack, and Win_clip_depth lets a test assert the two are balanced.
extern fn Win_clip_push(win: int, x: int, y: int, w: int, h: int) -> int;
extern fn Win_clip_pop(win: int) -> int;
extern fn Win_clip_depth(win: int) -> int;

// ---- Textures -------------------------------------------------------------
//
// Drawing an image with one Win_rect per pixel is not slow, it is unusable:
// a 1024x768 view is 786k calls a frame. An image viewport is one upload
// plus one blit.

extern fn Win_texture(win: int, width: int, height: int) -> int;
extern fn Win_texture_update(tex: int, rgba: ptr, w: int, h: int) -> int;

// Upload float32 RGBA, LINEAR and PREMULTIPLIED - the representation an
// imaging core already holds. Converts to display encoding internally.
extern fn Win_texture_update_f32(tex: int, rgba: ptr, w: int, h: int) -> int;

extern fn Win_blit(win: int, tex: int, dx: int, dy: int, dw: int, dh: int);
extern fn Win_texture_free(tex: int);

// ---- Text -----------------------------------------------------------------

// Load a .ttf at a pixel size. Returns a handle, or -1.
extern fn Win_font(path: string, pixel_height: int) -> int;

// First font that exists among the platform defaults, so a program need not
// ship a .ttf nor guess at per-OS font paths.
extern fn Win_font_default(pixel_height: int) -> int;

extern fn Win_text(win: int, font: int, s: string, x: int, y: int, r: int, g: int, b: int);

// Width Win_text would occupy. Layout needs this BEFORE drawing - to centre a
// label, size a button to its caption, or place a text cursor.
extern fn Win_text_width(font: int, s: string) -> int;

// Baseline-to-baseline distance; the natural line height.
extern fn Win_font_height(font: int) -> int;

extern fn Win_font_free(font: int);

// Save the current frame to a BMP. No assertion can tell you the UI LOOKED
// right, so this lets a test render headless and compare pixels.
extern fn Win_screenshot(win: int, path: string) -> int;

// Read one channel of one pixel off the rendered frame: 0..255, or -1 outside
// the window. channel 0=red, 1=green, 2=blue, 3=alpha.
//
// A screenshot proves a file was written; this proves the right thing was drawn.
// It is how a headless test tells "the texture blitted" from "the upload failed
// and the background shows through" - and channel-order bugs (red where blue
// belongs) are invisible to every other kind of assertion.
//
// The parameter is `chan`, not `channel`: `channel` is a reserved keyword (the
// concurrency primitive). Using it here does not say so - it reports "Expected
// parameter name" and then the extern is emitted with a `void` parameter, which
// surfaces as a C error about 'void' must be the first and only parameter.
extern fn Win_pixel_at(win: int, x: int, y: int, chan: int) -> int;

// ---- Input: polled state --------------------------------------------------

extern fn Win_mouse_x() -> int;
extern fn Win_mouse_y() -> int;
extern fn Win_mouse_pressed() -> int;
extern fn Win_key_down(scancode: int) -> int;
extern fn Win_delay(ms: int);

// ---- Input: the event queue ----------------------------------------------
//
// Polled state says "the button is down NOW". It cannot say "the button went
// down at (x,y) since you last looked", and a click that starts and ends
// between two polls is simply lost. Dragging, double-click, text entry and
// focus all need the transitions, so a retained-widget toolkit needs the queue.

extern fn Win_poll_event() -> int;
extern fn Win_event_x() -> int;
extern fn Win_event_y() -> int;
extern fn Win_event_button() -> int;
extern fn Win_event_key() -> int;

// 1 single, 2 double - reported by the platform, so do not hand-roll timing.
extern fn Win_event_clicks() -> int;

// For EV_TEXT: the typed UTF-8. Valid until the next Win_poll_event().
extern fn Win_event_text() -> string;

// Text input must be enabled explicitly: while active the OS may show an IME
// candidate window and sends TEXT events instead of raw keys. A text field
// enables on focus, disables on blur.
extern fn Win_text_input(win: int, enable: int);

// ---- Input: synthetic events (automated testing) --------------------------
//
// These push a REAL event onto the platform queue, so Win_poll_event() returns
// it exactly as it returns a human's. That matters: a test that instead pokes
// the toolkit's state directly proves only that assignment works, and skips the
// dispatch logic - which is the only part that can actually be wrong.
//
// They work under SDL_VIDEODRIVER=dummy, so a GUI can be tested in CI with no
// display attached. Each returns 1 if the event was queued.

extern fn Win_push_mouse_move(win: int, x: int, y: int) -> int;
extern fn Win_push_mouse_down(win: int, x: int, y: int, button: int) -> int;
extern fn Win_push_mouse_up(win: int, x: int, y: int, button: int) -> int;
extern fn Win_push_key_down(win: int, scancode: int) -> int;
extern fn Win_push_text(win: int, utf8: string) -> int;

// Event kinds returned by Win_poll_event()
var EV_NONE = 0
var EV_QUIT = 1
var EV_MOUSE_DOWN = 2
var EV_MOUSE_UP = 3
var EV_MOUSE_MOVE = 4
var EV_KEY_DOWN = 5
var EV_KEY_UP = 6
var EV_TEXT = 7
var EV_WHEEL = 8
var EV_RESIZE = 9

// Mouse buttons reported by Win_event_button()
var MOUSE_LEFT = 1
var MOUSE_MIDDLE = 2
var MOUSE_RIGHT = 3

// Scancodes for Win_key_down() and Win_event_key().
// Physical key positions, unchanged from SDL2 (SDL3 kept the scancode table).
//
// The whole alphabet, not a hand-picked subset. A partial table is worse than no
// table: a reference to a name that is missing (gui.SCANCODE_G, before this) is
// accepted by `wyn check` and then fails in the C compiler as "use of
// undeclared identifier 'gui_SCANCODE_G'" - so the gap surfaces as an internal
// codegen error rather than as "no such constant".
var SCANCODE_A = 4
var SCANCODE_B = 5
var SCANCODE_C = 6
var SCANCODE_D = 7
var SCANCODE_E = 8
var SCANCODE_F = 9
var SCANCODE_G = 10
var SCANCODE_H = 11
var SCANCODE_I = 12
var SCANCODE_J = 13
var SCANCODE_K = 14
var SCANCODE_L = 15
var SCANCODE_M = 16
var SCANCODE_N = 17
var SCANCODE_O = 18
var SCANCODE_P = 19
var SCANCODE_Q = 20
var SCANCODE_R = 21
var SCANCODE_S = 22
var SCANCODE_T = 23
var SCANCODE_U = 24
var SCANCODE_V = 25
var SCANCODE_W = 26
var SCANCODE_X = 27
var SCANCODE_Y = 28
var SCANCODE_Z = 29
var SCANCODE_RETURN = 40
var SCANCODE_ESCAPE = 41
var SCANCODE_BACKSPACE = 42
var SCANCODE_TAB = 43
var SCANCODE_SPACE = 44
var SCANCODE_DELETE = 76
var SCANCODE_RIGHT = 79
var SCANCODE_LEFT = 80
var SCANCODE_DOWN = 81
var SCANCODE_UP = 82
var SCANCODE_LCTRL = 224
var SCANCODE_LSHIFT = 225
var SCANCODE_LALT = 226
var SCANCODE_LGUI = 227

// The RIGHT-hand modifiers. Present because a shortcut check that tests only the
// left one is wrong for every user who holds Shift with their right hand - a bug
// that is invisible to a right-handed developer testing their own habits.
var SCANCODE_RCTRL = 228
var SCANCODE_RSHIFT = 229
var SCANCODE_RALT = 230
var SCANCODE_RGUI = 231

// Digits, in SDL's row order: 1..9 then 0. NOT contiguous with 0 first, which is
// the mistake this comment exists to prevent - SDL puts 0 AFTER 9.
var SCANCODE_1 = 30
var SCANCODE_2 = 31
var SCANCODE_3 = 32
var SCANCODE_4 = 33
var SCANCODE_5 = 34
var SCANCODE_6 = 35
var SCANCODE_7 = 36
var SCANCODE_8 = 37
var SCANCODE_9 = 38
var SCANCODE_0 = 39

// The bracket keys, which every image editor binds to brush size.
var SCANCODE_LEFTBRACKET = 47
var SCANCODE_RIGHTBRACKET = 48

// Punctuation used by zoom shortcuts: Cmd+- / Cmd+= (the unshifted `+` key).
var SCANCODE_MINUS = 45
var SCANCODE_EQUALS = 46

// Modifier BITS for the sampled-modifier word (see widgets.Ui_shortcut_mod_at).
// A bitmask rather than four parallel arrays: one int travels with one keystroke.
var KMOD_NONE = 0
var KMOD_SHIFT = 1
var KMOD_CTRL = 2
var KMOD_ALT = 4
var KMOD_GUI = 8
